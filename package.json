{
  "name": "-task-software-testing",
  "version": "1.0.0",
  "description": "This repository contains test cases (8 scenarios) written using Gherkin syntax (BDD). The scenarios are written for the [Practice Software Testing](https://practicesoftwaretesting.com/).",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome --headless",
    "cy:run:firefox": "cypress run --browser firefox --headless",
    "cy:run:edge": "cypress run --browser edge --headless",
    "cy:run:all-browsers": "npm run cy:run:chrome && npm run cy:run:firefox && npm run cy:run:edge",
    "lint": "eslint 'cypress/**/*.js'",
    "lint:fix": "eslint 'cypress/**/*.js' --fix",
    "format": "prettier --write 'cypress/**/*.js'",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AksanaBond/-Task-Software-Testing.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AksanaBond/-Task-Software-Testing/issues"
  },
  "homepage": "https://github.com/AksanaBond/-Task-Software-Testing#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cypress": "^15.18.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.4"
  },
  "lint-staged": {
  "*.{js,jsx,ts,tsx}": [
    "eslint --fix",
    "prettier --write"
  ]
}
}
